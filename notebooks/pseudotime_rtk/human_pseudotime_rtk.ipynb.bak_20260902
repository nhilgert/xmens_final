   "source": [
    "import cellrank as cr\n",
    "rtk = cr.kernels.RealTimeKernel.from_moscot(tp)\n",
    "try:\n",
    "    rtk = rtk.compute_transition_matrix(self_transitions=CFG[\"rtk_self_transitions\"], conn_weight=CFG[\"rtk_conn_weight\"], threshold=CFG[\"rtk_threshold\"])\n",
    "    T = rtk.transition_matrix; n_dead = 0\n",
    "    print(\"RealTimeKernel accepted the stitched matrix directly\")\n",
    "except ValueError as e:\n",
    "    if \"row stochastic\" not in str(e): raise\n",
    "    print(f\"RealTimeKernel rejected the matrix: {e}\\napplying the documented repair ...\")\n",
    "    T = rtk._transition_matrix if getattr(rtk, \"_transition_matrix\", None) is not None else \\\n",
    "        rtk._restich_couplings(rtk.couplings, self_transitions=CFG[\"rtk_self_transitions\"], conn_weight=CFG[\"rtk_conn_weight\"]).X\n",
    "    T = csr_matrix(T).tocsr()\n",
    "    rs = np.asarray(T.sum(axis=1)).ravel(); dead = np.where(~np.isfinite(rs) | (rs == 0))[0]; n_dead = len(dead)\n",
    "    print(f\"  dead rows (zero / non-finite): {n_dead}\")\n",
    "    day_vals = a.obs.day.astype(float).to_numpy()\n",
    "    if n_dead:\n",
    "        T_lil = T.tolil()\n",
    "        for i in dead:\n",
    "            same = np.where(day_vals == day_vals[i])[0]; T_lil.rows[i] = list(same); T_lil.data[i] = [1.0/len(same)]*len(same)\n",
    "        T = T_lil.tocsr()\n",
    "    rs = np.asarray(T.sum(axis=1)).ravel(); T = csr_matrix(T.multiply(1.0/rs[:, None]))\n",
    "    rtk.transition_matrix = T; T = rtk.transition_matrix; print(\"  assigned successfully\")\n",
    "rs = np.asarray(T.sum(axis=1)).ravel()\n",
    "verify(\"RTK transition matrix is row-stochastic\", np.allclose(rs, 1.0, atol=1e-6), note=f\"{T.shape}, {n_dead} rows repaired\")\n",
    "\n",
    "# forward-in-time structure check: what fraction of transition mass goes to a LATER day vs same day vs earlier\n",
    "dv = a.obs.day.astype(float).to_numpy(); Tc = T.tocoo()\n",
    "later, same, earlier = [float(Tc.data[np.sign(dv[Tc.col]-dv[Tc.row]) == s].sum()/Tc.data.sum()) for s in (1, 0, -1)]\n",
    "print(f\"transition mass: to later day {later:.3f} | same day {same:.3f} | earlier day {earlier:.3f}\")\n",
    "verify(\"no transition mass flows backward in time\", earlier < 1e-9)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c8231eac",
   "metadata": {},
   "source": [
    "## 4 — RTK-informed diffusion map (your cell 32)\n",
    "\n",
    "DPT's own transition matrix is replaced by the symmetrised RTK matrix, so the diffusion components — and every distance computed from them — live on the time-informed graph. The same symmetrised matrix feeds Palantir in §6."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8972c8c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "eigenvalues: [1.0001 0.9675 0.9545 0.9472 0.9316 0.9181 0.9004 0.8905]\n",
      "PASS  diffusion map has the requested components   [True]\n",
      "spearman(DC_i, subtype rank): {'DC1': -0.72, 'DC2': 0.631, 'DC3': -0.562, 'DC4': -0.259, 'DC5': 0.337}\n",
      "trajectory axis = DC1; early pole = DC1 max\n",
      "PASS  a DC carries the subtype ordering   [True]  |rho|=0.720\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1300x550 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from scanpy.tools._dpt import DPT\n",
    "def get_symmetric_transition_matrix(transition_matrix):\n",
    "    \"\"\"Symmetrize a transition matrix and re-normalize rows. Verbatim from fibdec_pseudotime_v2.ipynb (user helper, not a cellrank function).\"\"\"\n",
    "    sym_mat = (transition_matrix + transition_matrix.T) / 2\n",
    "    row_sums = sym_mat.sum(axis=1).A1\n",
    "    sym_mat.data = sym_mat.data / row_sums[sym_mat.nonzero()[0]]\n",
    "    return sym_mat\n",
    "sc.pp.neighbors(a, use_rep=CFG[\"latent\"], n_neighbors=CFG[\"knn_control\"], random_state=CFG[\"seed\"])   # plain-kNN control graph\n",
    "dpt_obj = DPT(adata=a, neighbors_key=\"neighbors\")\n",
    "T_sym = get_symmetric_transition_matrix(rtk.transition_matrix)\n",
    "dpt_obj._transitions_sym = T_sym\n",
    "dpt_obj.compute_eigen(n_comps=CFG[\"n_diffmap_comps\"], random_state=CFG[\"seed\"])\n",
    "a.obsm[\"X_diffmap\"] = dpt_obj.eigen_basis; a.uns[\"diffmap_evals\"] = dpt_obj.eigen_values\n",
    "print(\"eigenvalues:\", np.round(a.uns[\"diffmap_evals\"][:8], 4))\n",
    "DM = a.obsm[\"X_diffmap\"]; O = a.obs\n",
    "verify(\"diffusion map has the requested components\", DM.shape == (a.n_obs, CFG[\"n_diffmap_comps\"]))\n",
    "\n",
    "# which DC carries the fib -> dec axis, and which end is early? measured, never assumed\n",
    "sr = O.cell_subtype.map(RANK).to_numpy(float); ok = np.isfinite(sr)\n",
    "rhos = {i: float(spearmanr(DM[ok, i], sr[ok]).statistic) for i in range(1, min(6, DM.shape[1]))}\n",
    "BEST_DC = max(rhos, key=lambda i: abs(rhos[i])); EARLY = \"min\" if rhos[BEST_DC] > 0 else \"max\"\n",
    "print(\"spearman(DC_i, subtype rank):\", {f\"DC{i}\": round(v, 3) for i, v in rhos.items()})\n",
    "print(f\"trajectory axis = DC{BEST_DC}; early pole = DC{BEST_DC} {EARLY}\")\n",
    "verify(\"a DC carries the subtype ordering\", abs(rhos[BEST_DC]) > 0.3, note=f\"|rho|={abs(rhos[BEST_DC]):.3f}\")\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))\n",
    "for ax, (pal, col) in zip(axes, ((PAL, \"cell_subtype\"), (TPAL, \"timepoint\"))):\n",
    "    for cat in (SUBORDER if col == \"cell_subtype\" else TPORDER):\n",
    "        mm = (O[col] == cat).to_numpy()\n",
    "        if mm.any(): ax.scatter(DM[mm, BEST_DC], DM[mm, 2 if BEST_DC != 2 else 3], s=2, c=[pal[cat]], label=cat, rasterized=True)\n",
    "    ax.set_xlabel(f\"DC{BEST_DC} (early = {EARLY})\"); ax.set_ylabel(f\"DC{2 if BEST_DC != 2 else 3}\"); ax.legend(fontsize=7, markerscale=4)\n",
    "fig.suptitle(\"RTK-informed diffusion map\"); fig.tight_layout()"
   ]
  },
  {
