   "source": [
    "a = sc.read_h5ad(SRC); n0 = a.n_obs\n",
    "for c in (\"cell_subtype\",\"timepoint\",\"sample\"): a.obs[c] = a.obs[c].astype(str)\n",
    "a = a[a.obs.cell_subtype != \"decidual_apoptotic\"].copy()   # the only drop: annotated apoptotic cluster. uninduced and efib_outer KEPT\n",
    "print(\"loaded\", a.shape, \"| dropped:\", n0 - a.n_obs)\n",
    "verify(\"X_scVI present (reused, not retrained)\", CFG[\"latent\"] in a.obsm)\n",
    "verify(\"counts layer present\", \"counts\" in a.layers)\n",
    "verify(\"QC'd coordinates + tissue_section present\", {\"x_um_qc\",\"y_um_qc\",\"tissue_section\"} <= set(a.obs.columns))\n",
    "if \"dpt_pseudotime\" in a.obs: a.obs = a.obs.rename(columns={\"dpt_pseudotime\": \"dpt_pseudotime_onobject\"})   # keep the old one for comparison in §9\n",
    "\n",
    "mapping = {tp: d for tp, d in CFG[\"timepoint_to_day\"].items() if tp in set(a.obs.timepoint)}\n",
    "unmapped = sorted(set(a.obs.timepoint) - set(mapping)); assert not unmapped, f\"timepoints with no day: {unmapped}\"\n",
    "a.obs[\"day\"] = a.obs.timepoint.map(mapping).astype(float).astype(\"category\")   # float-categorical: numeric order preserved\n",
    "n_tp = len(a.obs.day.cat.categories)\n",
    "print(\"day categories:\", list(a.obs.day.cat.categories), f\"-> moscot couples {n_tp-1} consecutive transition(s)\")\n",
    "if n_tp == 2: print(\"  NOTE: a single transition — the real-time constraint is weak\")\n",
    "display(pd.crosstab(a.obs.cell_subtype, a.obs.timepoint).reindex(index=[s for s in SUBORDER if s in set(a.obs.cell_subtype)], columns=TPORDER))"
   ]
  },
