   "source": [
    "ROOT_BARCODE = None\n",
    "ROOT = dict(subtype=\"efib_outer\", timepoint=\"uninduced\", pct=0)   # earliest subtype in the user's order, earliest day\n",
    "\n",
    "def _resolve(subtype=None, timepoint=None, pct=0):\n",
    "    m = np.ones(a.n_obs, bool)\n",
    "    if subtype:   m &= (O.cell_subtype == subtype).to_numpy()\n",
    "    if timepoint: m &= (O.timepoint == timepoint).to_numpy()\n",
    "    if not m.any(): raise ValueError(f\"filter {dict(subtype=subtype, timepoint=timepoint)} matches 0 cells; timepoints {sorted(set(O.timepoint))}, subtypes {sorted(set(O.cell_subtype))}\")\n",
    "    v = DM[:, BEST_DC].copy(); v[~m] = np.nan\n",
    "    q = np.nanpercentile(v, pct if EARLY == \"min\" else 100 - pct)\n",
    "    idx = int(np.nanargmin(np.abs(v - q)))\n",
    "    return O.index[idx], idx, int(m.sum())\n",
    "\n",
    "def root_grid():\n",
    "    rows = []\n",
    "    for st in [s for s in SUBORDER if s in set(O.cell_subtype)]:\n",
    "        for tpn in [t for t in TPORDER if t in set(O.timepoint)]:\n",
    "            m = ((O.cell_subtype == st) & (O.timepoint == tpn)).to_numpy()\n",
    "            if m.sum() < 50: continue\n",
    "            ext = DM[m, BEST_DC].min() if EARLY == \"min\" else DM[m, BEST_DC].max()\n",
    "            depth = float((DM[:, BEST_DC] > ext).mean() if EARLY == \"min\" else (DM[:, BEST_DC] < ext).mean())\n",
    "            rows.append(dict(subtype=st, timepoint=tpn, n=int(m.sum()), depth_into_early_pole=round(depth, 4)))\n",
    "    return pd.DataFrame(rows).sort_values(\"depth_into_early_pole\", ascending=False)\n",
    "print(\"root options (depth 1.00 = deepest into the early pole):\"); display(root_grid().head(24))\n",
    "\n",
    "if ROOT_BARCODE:\n",
    "    assert ROOT_BARCODE in O.index; ROOT_BC, ROOT_IDX, npool = ROOT_BARCODE, int(O.index.get_loc(ROOT_BARCODE)), 1\n",
    "else:\n",
    "    ROOT_BC, ROOT_IDX, npool = _resolve(**ROOT)\n",
    "print(f\"\\nroot: {ROOT_BC}  subtype={O.cell_subtype.iloc[ROOT_IDX]}  timepoint={O.timepoint.iloc[ROOT_IDX]}  sample={O['sample'].iloc[ROOT_IDX]}  (pool {npool})\")\n",
    "verify(\"root subtype is the first in SUBORDER\", RANK[O.cell_subtype.iloc[ROOT_IDX]] == 0,\n",
    "       note=\"a later-subtype root pins that subtype to 0 and drags earlier ones behind it\")\n",
    "verify(\"root is at the earliest day\", float(O.day.iloc[ROOT_IDX]) == float(O.day.astype(float).min()))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c7c7ac34",
   "metadata": {},
   "source": [
    "## 6 — DPT and Palantir from that root, on the RTK graph; Palantir on plain kNN as control\n",
    "\n",
    "`palantir.utils.run_diffusion_maps` accepts an adjacency matrix directly, so the symmetrised RTK matrix goes in as-is (`alpha=0`: the RTK is already a normalised operator). The control is Palantir's own kNN kernel on `X_scVI`."
   ]
  },
