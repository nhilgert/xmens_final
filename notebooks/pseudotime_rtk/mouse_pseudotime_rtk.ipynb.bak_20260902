      "\u001b[36mFile \u001b[39m\u001b[32m/n/lab_storage/eddy_lab/users/nhilgert/.uv/envs/rsc_uv/lib/python3.11/site-packages/sklearn/utils/_set_output.py:316\u001b[39m, in \u001b[36m_wrap_method_output.<locals>.wrapped\u001b[39m\u001b[34m(self, X, *args, **kwargs)\u001b[39m\n\u001b[32m    314\u001b[39m \u001b[38;5;129m@wraps\u001b[39m(f)\n\u001b[32m    315\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34mwrapped\u001b[39m(\u001b[38;5;28mself\u001b[39m, X, *args, **kwargs):\n\u001b[32m--> \u001b[39m\u001b[32m316\u001b[39m     data_to_wrap = \u001b[43mf\u001b[49m\u001b[43m(\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mX\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43margs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43m*\u001b[49m\u001b[43mkwargs\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    317\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28misinstance\u001b[39m(data_to_wrap, \u001b[38;5;28mtuple\u001b[39m):\n\u001b[32m    318\u001b[39m         \u001b[38;5;66;03m# only wrap the first output for cross decomposition\u001b[39;00m\n\u001b[32m    319\u001b[39m         return_tuple = (\n\u001b[32m    320\u001b[39m             _wrap_data_with_container(method, data_to_wrap[\u001b[32m0\u001b[39m], X, \u001b[38;5;28mself\u001b[39m),\n\u001b[32m    321\u001b[39m             *data_to_wrap[\u001b[32m1\u001b[39m:],\n\u001b[32m    322\u001b[39m         )\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/n/lab_storage/eddy_lab/users/nhilgert/.uv/envs/rsc_uv/lib/python3.11/site-packages/pynndescent/pynndescent_.py:2838\u001b[39m, in \u001b[36mPyNNDescentTransformer.fit_transform\u001b[39m\u001b[34m(self, X, y, **fit_params)\u001b[39m\n\u001b[32m   2818\u001b[39m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[34mfit_transform\u001b[39m(\u001b[38;5;28mself\u001b[39m, X, y=\u001b[38;5;28;01mNone\u001b[39;00m, **fit_params):\n\u001b[32m   2819\u001b[39m \u001b[38;5;250m    \u001b[39m\u001b[33;03m\"\"\"Fit to graph_data, then transform it.\u001b[39;00m\n\u001b[32m   2820\u001b[39m \n\u001b[32m   2821\u001b[39m \u001b[33;03m    Fits transformer to X and y with optional parameters fit_params\u001b[39;00m\n\u001b[32m   (...)\u001b[39m\u001b[32m   2836\u001b[39m \u001b[33;03m        The diagonal is always explicit.\u001b[39;00m\n\u001b[32m   2837\u001b[39m \u001b[33;03m    \"\"\"\u001b[39;00m\n\u001b[32m-> \u001b[39m\u001b[32m2838\u001b[39m     \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mfit\u001b[49m\u001b[43m(\u001b[49m\u001b[43mX\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mcompress_index\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43;01mFalse\u001b[39;49;00m\u001b[43m)\u001b[49m\n\u001b[32m   2839\u001b[39m     result = \u001b[38;5;28mself\u001b[39m.transform(X=\u001b[38;5;28;01mNone\u001b[39;00m)\n\u001b[32m   2841\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28mself\u001b[39m.verbose:\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/n/lab_storage/eddy_lab/users/nhilgert/.uv/envs/rsc_uv/lib/python3.11/site-packages/pynndescent/pynndescent_.py:2756\u001b[39m, in \u001b[36mPyNNDescentTransformer.fit\u001b[39m\u001b[34m(self, X, compress_index)\u001b[39m\n\u001b[32m   2752\u001b[39m \u001b[38;5;66;03m# Compatibility with sklearn, which doesn't consider\u001b[39;00m\n\u001b[32m   2753\u001b[39m \u001b[38;5;66;03m# a point its own neighbor for these purposes.\u001b[39;00m\n\u001b[32m   2754\u001b[39m effective_n_neighbors = \u001b[38;5;28mself\u001b[39m.n_neighbors + \u001b[32m1\u001b[39m\n\u001b[32m-> \u001b[39m\u001b[32m2756\u001b[39m \u001b[38;5;28mself\u001b[39m.index_ = \u001b[43mNNDescent\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m   2757\u001b[39m \u001b[43m    \u001b[49m\u001b[43mX\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2758\u001b[39m \u001b[43m    \u001b[49m\u001b[43mmetric\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mmetric\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2759\u001b[39m \u001b[43m    \u001b[49m\u001b[43mmetric_kwds\u001b[49m\u001b[43m=\u001b[49m\u001b[43mmetric_kwds\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2760\u001b[39m \u001b[43m    \u001b[49m\u001b[43mn_neighbors\u001b[49m\u001b[43m=\u001b[49m\u001b[43meffective_n_neighbors\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2761\u001b[39m \u001b[43m    \u001b[49m\u001b[43mn_trees\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mn_trees\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2762\u001b[39m \u001b[43m    \u001b[49m\u001b[43mleaf_size\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mleaf_size\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2763\u001b[39m \u001b[43m    \u001b[49m\u001b[43mpruning_degree_multiplier\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mpruning_degree_multiplier\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2764\u001b[39m \u001b[43m    \u001b[49m\u001b[43mdiversify_prob\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mdiversify_prob\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2765\u001b[39m \u001b[43m    \u001b[49m\u001b[43mn_search_trees\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mn_search_trees\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2766\u001b[39m \u001b[43m    \u001b[49m\u001b[43mtree_init\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mtree_init\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2767\u001b[39m \u001b[43m    \u001b[49m\u001b[43mrandom_state\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mrandom_state\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2768\u001b[39m \u001b[43m    \u001b[49m\u001b[43mlow_memory\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mlow_memory\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2769\u001b[39m \u001b[43m    \u001b[49m\u001b[43mmax_candidates\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mmax_candidates\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2770\u001b[39m \u001b[43m    \u001b[49m\u001b[43mn_iters\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mn_iters\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2771\u001b[39m \u001b[43m    \u001b[49m\u001b[43mdelta\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mearly_termination_value\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2772\u001b[39m \u001b[43m    \u001b[49m\u001b[43mn_jobs\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mn_jobs\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2773\u001b[39m \u001b[43m    \u001b[49m\u001b[43mcompressed\u001b[49m\u001b[43m=\u001b[49m\u001b[43mcompress_index\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2774\u001b[39m \u001b[43m    \u001b[49m\u001b[43mparallel_batch_queries\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mparallel_batch_queries\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2775\u001b[39m \u001b[43m    \u001b[49m\u001b[43mverbose\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mverbose\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   2776\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m   2778\u001b[39m \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28mself\u001b[39m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/n/lab_storage/eddy_lab/users/nhilgert/.uv/envs/rsc_uv/lib/python3.11/site-packages/pynndescent/pynndescent_.py:1225\u001b[39m, in \u001b[36mNNDescent.__init__\u001b[39m\u001b[34m(self, data, metric, metric_kwds, n_neighbors, n_trees, leaf_size, pruning_degree_multiplier, diversify_prob, diversify_method, degree_prune_aggressiveness, n_search_trees, search_tree_leaf_size, max_search_tree_depth, quantization, tree_init, init_graph, init_dist, random_state, low_memory, max_candidates, max_rptree_depth, n_iters, delta, n_jobs, compressed, parallel_batch_queries, verbose)\u001b[39m\n\u001b[32m   1222\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m verbose:\n\u001b[32m   1223\u001b[39m         \u001b[38;5;28mprint\u001b[39m(ts(), \u001b[33m\"\u001b[39m\u001b[33mNN descent for\u001b[39m\u001b[33m\"\u001b[39m, \u001b[38;5;28mstr\u001b[39m(n_iters), \u001b[33m\"\u001b[39m\u001b[33miterations\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m-> \u001b[39m\u001b[32m1225\u001b[39m     \u001b[38;5;28mself\u001b[39m._neighbor_graph = \u001b[43mnn_descent\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m   1226\u001b[39m \u001b[43m        \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_raw_data\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1227\u001b[39m \u001b[43m        \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mn_neighbors\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1228\u001b[39m \u001b[43m        \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mrng_state\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1229\u001b[39m \u001b[43m        \u001b[49m\u001b[43meffective_max_candidates\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1230\u001b[39m \u001b[43m        \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_distance_func\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1231\u001b[39m \u001b[43m        \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mn_iters\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1232\u001b[39m \u001b[43m        \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mdelta\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1233\u001b[39m \u001b[43m        \u001b[49m\u001b[43mlow_memory\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mlow_memory\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1234\u001b[39m \u001b[43m        \u001b[49m\u001b[43mrp_tree_init\u001b[49m\u001b[43m=\u001b[49m\u001b[38;5;28;43;01mTrue\u001b[39;49;00m\u001b[43m,\u001b[49m\n\u001b[32m   1235\u001b[39m \u001b[43m        \u001b[49m\u001b[43minit_graph\u001b[49m\u001b[43m=\u001b[49m\u001b[43m_init_graph\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1236\u001b[39m \u001b[43m        \u001b[49m\u001b[43mleaf_array\u001b[49m\u001b[43m=\u001b[49m\u001b[43mleaf_array\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1237\u001b[39m \u001b[43m        \u001b[49m\u001b[43mverbose\u001b[49m\u001b[43m=\u001b[49m\u001b[43mverbose\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1238\u001b[39m \u001b[43m    \u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m   1240\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m np.any(\u001b[38;5;28mself\u001b[39m._neighbor_graph[\u001b[32m0\u001b[39m] < \u001b[32m0\u001b[39m):\n\u001b[32m   1241\u001b[39m     warn(\n\u001b[32m   1242\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33mFailed to correctly find n_neighbors for some samples.\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1243\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33m Results may be less than ideal. Try re-running with\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1244\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33m different parameters.\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1245\u001b[39m     )\n",
      "\u001b[31mMemoryError\u001b[39m: Allocation failed (probably too large)."
     ]
    }
   ],
   "source": [
    "import palantir\n",
    "a.uns[\"iroot\"] = ROOT_IDX\n",
    "sc.tl.dpt(a, n_dcs=CFG[\"n_diffmap_comps\"])                      # uses a.obsm[\"X_diffmap\"] = the RTK-informed one\n",
    "res = O[[\"cell_subtype\",\"timepoint\",\"sample\",\"x_um_qc\",\"y_um_qc\",\"tissue_section\"]].copy()\n",
    "res[\"dpt_rtk\"] = a.obs[\"dpt_pseudotime\"].to_numpy(float)\n",
    "\n",
    "def run_pal(dm_input, label):\n",
    "    t0 = time.time()\n",
    "    dm = palantir.utils.run_diffusion_maps(dm_input, n_components=CFG[\"n_diffmap_comps\"], knn=CFG[\"knn_control\"], seed=CFG[\"seed\"])\n",
    "    ms = palantir.utils.determine_multiscale_space(dm)\n",
    "    pr = palantir.core.run_palantir(ms, early_cell=ROOT_BC, use_early_cell_as_start=True,\n",
    "                                    num_waypoints=CFG[\"palantir_waypoints\"], seed=CFG[\"seed\"])\n",
    "    print(f\"{label}: {time.time()-t0:.0f}s | multiscale dims {ms.shape[1]}\")\n",
    "    return pr.pseudotime.reindex(O.index).to_numpy(float)\n",
    "\n",
    "A_rtk = pd.DataFrame.sparse.from_spmatrix(csr_matrix(T_sym), index=O.index, columns=O.index)\n",
    "res[\"palantir_rtk\"] = run_pal(A_rtk, \"Palantir on RTK graph\")\n",
    "res[\"palantir_knn\"] = run_pal(pd.DataFrame(a.obsm[CFG[\"latent\"]], index=O.index), \"Palantir on plain kNN (control)\")\n",
    "if \"dpt_pseudotime_onobject\" in O: res[\"dpt_onobject\"] = pd.to_numeric(O.dpt_pseudotime_onobject, errors=\"coerce\").to_numpy(float)\n",
    "\n",
    "METHODS = [\"dpt_rtk\", \"palantir_rtk\", \"palantir_knn\"]\n",
    "for m in METHODS:\n",
    "    verify(f\"{m}: finite everywhere\", np.isfinite(res[m]).all(), note=f\"{int((~np.isfinite(res[m])).sum())} non-finite\")\n",
    "    verify(f\"{m}: is 0 at the root\", float(res[m].iloc[ROOT_IDX]) == 0.0 or abs(float(res[m].iloc[ROOT_IDX])) < 1e-9, note=f\"{res[m].iloc[ROOT_IDX]:.4g}\")\n",
    "print(\"\\nmethod agreement (spearman):\")\n",
    "display(res[METHODS + ([c for c in (\"dpt_onobject\",) if c in res])].corr(method=\"spearman\").round(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bb7b7973",
   "metadata": {},
   "source": [
    "## 7 — quantile normalisation\n",
    "\n",
    "`_q` global percentile, `_qsec` within section; ordering preservation asserted."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3690abb2",
   "metadata": {},
   "outputs": [],
   "source": [
    "for m in METHODS:\n",
    "    res[f\"{m}_q\"]    = res[m].rank(pct=True)\n",
    "    res[f\"{m}_qsec\"] = res.groupby(\"tissue_section\", observed=True)[m].rank(pct=True)\n",
    "    verify(f\"{m}: quantile transform preserves ordering\", float(spearmanr(res[m], res[f\"{m}_q\"]).statistic) == 1.0)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d89651a0",
   "metadata": {},
   "source": [
    "## 8 — orientation gates (REFUSED, never flipped)\n",
    "\n",
    "Subtype-rank ρ overall and within fibroblasts; day ρ within the decidual compartment (pooled day ρ is composition-confounded). The root-pinning check catches a root whose own subtype is dragged to zero ahead of earlier ones."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5e0ae7f4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def gates(pt):\n",
    "    sr = res.cell_subtype.map(RANK).to_numpy(float); tr = res.timepoint.map(TPRANK).to_numpy(float); ok = np.isfinite(pt)\n",
    "    dec = ok & res.cell_subtype.str.startswith(\"decidual\").to_numpy(); fib = ok & ~res.cell_subtype.str.startswith(\"decidual\").to_numpy()\n",
    "    rho = lambda m, y: round(float(spearmanr(pt[m], y[m]).statistic), 4) if m.sum() > 50 else None\n",
    "    med = pd.Series(pt, index=res.index).groupby(res.cell_subtype).median()\n",
    "    root_sub = O.cell_subtype.iloc[ROOT_IDX]\n",
    "    pinned = [s for s in SUBORDER if s in med and RANK[s] < RANK[root_sub] and med[s] > med[root_sub]]\n",
    "    d = dict(rho_subtype=rho(ok, sr), rho_subtype_fibroblasts=rho(fib, sr), rho_day_all=rho(ok, tr),\n",
    "             rho_day_decidual_only=rho(dec, tr), rho_day_fibroblasts_only=rho(fib, tr), subtypes_pinned_behind_root=pinned)\n",
    "    bad = (d[\"rho_subtype\"] or 0) <= 0 or (d[\"rho_day_decidual_only\"] or 0) <= 0\n",
    "    d[\"verdict\"] = \"REFUSED — orientation gate failed; NOT flipped, choose another root\" if bad else \"OK\"\n",
    "    return d\n",
    "GATES = {m: gates(res[m].to_numpy()) for m in METHODS}; display(pd.DataFrame(GATES).T)\n",
    "for m, g in GATES.items():\n",
    "    verify(f\"{m}: orientation\", g[\"verdict\"] == \"OK\", note=g[\"verdict\"])\n",
    "    verify(f\"{m}: no subtype pinned behind the root\", not g[\"subtypes_pinned_behind_root\"], note=str(g[\"subtypes_pinned_behind_root\"]))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c814c4e9",
   "metadata": {},
   "source": [
    "## 9 — violins: raw vs quantile, fill = category median\n",
    "\n",
    "One figure per method (rows) × grouping. Fill colour = that category's median on the column's own scale, matching the spatial panels."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "25086e37",
   "metadata": {},
   "outputs": [],
   "source": [
    "def violins(by, order=None, cmap=\"viridis\", methods=METHODS):\n",
    "    order = order or [s for s in (SUBORDER if by == \"cell_subtype\" else TPORDER) if s in set(res[by])]\n",
    "    fig, axes = plt.subplots(len(methods), 2, figsize=(16, 4.4*len(methods)), sharex=True, squeeze=False)\n",
    "    meds = {}\n",
    "    for i, m in enumerate(methods):\n",
    "        for j, col in enumerate((m, f\"{m}_q\")):\n",
    "            ax = axes[i][j]\n",
    "            med = res.groupby(by, observed=True)[col].median().reindex(order); meds[col] = med\n",
    "            norm = Normalize(vmin=float(res[col].min()), vmax=float(res[col].max()))\n",
    "            colours = {c_: plt.get_cmap(cmap)(norm(med[c_])) for c_ in order if pd.notna(med[c_])}\n",
    "            sns.violinplot(data=res, x=by, y=col, order=order, hue=by, hue_order=order, palette=colours, legend=False, cut=0, linewidth=.6, ax=ax)\n",
    "            for k, c_ in enumerate(order):\n",
    "                if pd.notna(med.get(c_)): ax.plot([k-.35, k+.35], [med[c_]]*2, c=\"k\", lw=1.8, zorder=5)\n",
    "            ax.set_title(f\"{m} — {'quantile' if col.endswith('_q') else 'raw'}\", fontsize=10); ax.set_xlabel(\"\"); ax.tick_params(axis=\"x\", rotation=35, labelsize=8)\n",
    "            cb = fig.colorbar(ScalarMappable(norm=norm, cmap=cmap), ax=ax, fraction=.046, pad=.02); cb.set_label(f\"median {col}\", fontsize=7); cb.ax.tick_params(labelsize=7)\n",
    "    fig.suptitle(f\"by {by} — fill = category median; black bar = median; root {ROOT_BC}\", y=1.0); fig.tight_layout()\n",
    "    return fig, pd.DataFrame(meds).round(4)\n",
    "fig, MED_SUB = violins(\"cell_subtype\"); display(MED_SUB)\n",
    "fig, MED_TP  = violins(\"timepoint\");    display(MED_TP)\n",
    "res[\"compartment\"] = np.where(res.cell_subtype.str.contains(\"decidual\"), \"decidual\", \"fibroblast\")\n",
    "print(\"median quantile pseudotime by timepoint x compartment (pooled violins are composition-driven):\")\n",
    "display(res.pivot_table(index=\"timepoint\", columns=\"compartment\", values=[f\"{m}_q\" for m in METHODS], aggfunc=\"median\", observed=True).reindex(TPORDER).round(3))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ac140458",
   "metadata": {},
   "source": [
    "## 10 — spatial: one row per section; columns = methods, raw and quantile\n",
    "\n",
    "Raw and global quantile share a colour scale across sections; sections never pooled within a timepoint."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0ece7436",
   "metadata": {},
   "outputs": [],
   "source": [
    "SP = res[np.isfinite(res.x_um_qc) & res.tissue_section.notna() & (res.tissue_section.astype(str) != \"nan\")].copy()\n",
    "SEC2TP = SP.groupby(\"tissue_section\", observed=True).timepoint.first().to_dict()\n",
    "secs = sorted(SP.tissue_section.unique(), key=lambda s: (TPRANK.get(SEC2TP[s], 99), s))\n",
    "print(f\"{len(SP):,} cells with a coordinate | {len(secs)} sections\")\n",
    "\n",
    "def spatial(methods=METHODS, suffix=\"_q\", per=3.3, s=3.0):\n",
    "    cols = [f\"{m}{suffix}\" for m in methods]\n",
    "    fig, axes = plt.subplots(len(secs), len(cols), figsize=(per*len(cols), per*len(secs)*.92), squeeze=False)\n",
    "    for i, sec in enumerate(secs):\n",
    "        g = SP[SP.tissue_section == sec]\n",
    "        for j, col in enumerate(cols):\n",
    "            ax = axes[i][j]; vmin, vmax = (0, 1) if suffix == \"_qsec\" else (float(SP[col].min()), float(SP[col].max()))\n",
    "            sm = ax.scatter(g.x_um_qc, g.y_um_qc, c=g[col], s=s, cmap=\"viridis\", vmin=vmin, vmax=vmax, rasterized=True)\n",
    "            ax.set_aspect(\"equal\"); ax.set_xticks([]); ax.set_yticks([])\n",
    "            if i == 0: ax.set_title(col, fontsize=9)\n",
    "            if j == 0: ax.set_ylabel(f\"{SEC2TP[sec]}\\n{sec}\\nn={len(g):,}\", fontsize=7)\n",
    "            plt.colorbar(sm, ax=ax, fraction=.046, pad=.02).ax.tick_params(labelsize=6)\n",
    "    fig.suptitle({\"\": \"raw\", \"_q\": \"quantile (global)\", \"_qsec\": \"quantile (within section)\"}[suffix], y=1.0); fig.tight_layout(); return fig\n",
    "_ = spatial(suffix=\"_q\"); _ = spatial(suffix=\"\"); _ = spatial(suffix=\"_qsec\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "413a695c",
   "metadata": {},
   "source": [
    "### pseudotime vs isodepth per section (if the isodepth object is present)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "728d3d77",
   "metadata": {},
   "outputs": [],
   "source": [
    "if ISO.exists():\n",
    "    import h5py\n",
    "    try:    from anndata.io import read_elem\n",
    "    except ImportError: from anndata.experimental import read_elem\n",
    "    with h5py.File(ISO, \"r\") as f:\n",
    "        iso = pd.Series(np.asarray(read_elem(f[\"obs/isodepth_consensus\"])).ravel(), index=np.asarray(read_elem(f[\"obs/_index\"])).ravel()).astype(float)\n",
    "    SP[\"isodepth\"] = iso.reindex(SP.index).to_numpy()\n",
    "    rows = []\n",
    "    for sec in secs:\n",
    "        g = SP[(SP.tissue_section == sec) & np.isfinite(SP.isodepth)]\n",
    "        if len(g) < 50: continue\n",
    "        rows.append(dict(section=sec, timepoint=SEC2TP[sec], n=len(g), **{m: round(float(spearmanr(g[m], g.isodepth).statistic), 3) for m in METHODS}))\n",
    "    display(pd.DataFrame(rows).set_index(\"section\"))\n",
    "else:\n",
    "    print(\"isodepth object not found at\", ISO)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9ea48959",
   "metadata": {},
   "source": [
    "## 11 — save\n",
    "\n",
    "Per-cell table with all three pseudotimes (+ the one that was on the object) and a report; the h5ad is not modified."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7637ac9c",
   "metadata": {},
   "outputs": [],
   "source": [
    "tag = (ROOT_BARCODE or f\"{ROOT.get('timepoint','any')}_{ROOT.get('subtype','any')}\").replace(\"/\", \"_\")\n",
    "res.to_csv(OUT/f\"pseudotime_rtk_{tag}.csv\")\n",
    "json.dump(dict(species=\"mouse\", source=str(SRC), n_cells=int(a.n_obs), root=ROOT_BC, root_spec=(ROOT_BARCODE or ROOT), best_dc=int(BEST_DC), early=EARLY,\n",
    "               config=CFG, n_transitions=int(n_tp-1), rtk_dead_rows_repaired=int(n_dead), transition_mass=dict(later=later, same=same, earlier=earlier),\n",
    "               gates=GATES, methods=METHODS, versions=dict(cellrank=cr.__version__, palantir=palantir.__version__, scanpy=sc.__version__),\n",
    "               use_early_cell_as_start=True, checks=[dict(label=l, ok=o, got=g) for l, o, g, _ in CHECKS]),\n",
    "          open(OUT/f\"pseudotime_rtk_{tag}_report.json\", \"w\"), indent=1, default=str)\n",
    "bad = [l for l, o, _, _ in CHECKS if not o]\n",
    "print(\"wrote\", OUT/f\"pseudotime_rtk_{tag}.csv\"); print(f\"{len(CHECKS)} checks | {len(bad)} FAILED\" + (\": \" + \"; \".join(bad) if bad else \" — all passed\"))"
   ]
  }
