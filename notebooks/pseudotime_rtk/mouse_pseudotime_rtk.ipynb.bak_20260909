     "text": [
      "FAIL  dpt_rtk: quantile transform preserves ordering   [False]\n",
      "PASS  palantir_rtk: quantile transform preserves ordering   [True]\n",
      "PASS  palantir_knn: quantile transform preserves ordering   [True]\n"
     ]
    }
   ],
   "source": [
    "for m in METHODS:\n",
    "    res[f\"{m}_q\"]    = res[m].rank(pct=True)\n",
    "    res[f\"{m}_qsec\"] = res.groupby(\"tissue_section\", observed=True)[m].rank(pct=True)\n",
    "    verify(f\"{m}: quantile transform preserves ordering\", float(spearmanr(res[m], res[f\"{m}_q\"]).statistic) == 1.0)"
   ]
  },
