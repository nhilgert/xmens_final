from pathlib import Path

import pandas as pd
configfile: "config/config.yaml"
samples = pd.read_csv("config/samples.tsv", sep="\t").set_index("sample_id", drop=False)
SPECIES   = sorted(samples["species"].unique())
SLIDETAGS = list(samples.index[samples["modality"] == "slidetags"])


# Pin wildcards so latent_{species}.h5ad (step 07) cannot swallow
# latent_{species}_{lineage}.h5ad (step 09). Without this, `integrate`
# matches species="mouse_perimetrium" and the DAG goes off a cliff.
wildcard_constraints:
    species="human|mouse",
    lineage="epithelial|immune|perimetrium|perivascular|smc|stromal|vascular",

def species_samples(w):
    ids = samples.index[samples["species"] == w.species]
    return expand("data/interim/raw/{sample}.h5ad", sample=ids)

# The release of record, the release map and the reader registry, used by every rule file below.
include: "rules/00_release.smk"

# One rule file per step, in pipeline order.
#   01-06  raw data to per-species objects (provenance; defined only with config flags)
#   07-12  atlas: integration, annotation, lineages, spatial QC
#   13-17b round 2 and the release of record (15 defines and finalizes it, 16 rebuilds its round-2 objects),
#          deposit copies, and the human pseudotime of record (17b, decision G)
#   18-25  analyses: marker DE, SAMap, MI pseudotime genes, spatial GP, SCENIC, zone modules
#   26-28  review notebooks and reports (not in the default target)
#   29-36  figure panels of the revision
#   37     the numbers quoted in the Methods, rebuilt from the release
STEPS = [
    "01_cellbender", "02_slidetags", "03_ingest", "04_qc", "05_qc_report", "06_concat",
    "07_integrate", "08_annotate", "09_reintegrate_lineages", "10_annotate_lineages", "11_reembed", "12_spatial_qc",
    "13_reintegrate_round2", "14_annotate_round2", "15_release", "16_release_round2", "17_deposit",
    "17b_pseudotime_of_record",
    "18_marker_de", "19_homology", "20_samap_transfer", "21_samap_raw", "22_mi_pseudotime", "23_spatial_gp",
    "24_scenic", "25_zone_modules",
    "26_review_clustree", "27_review_notebooks", "28_reports",
    "29_fig_samap", "30_fig_mouse_tissue", "31_fig_mouse_stroma", "32_fig_human_tissue", "33_fig_human_epithelium",
    "34_fig_cross_species", "35_fig_programs", "36_fig_marker_dotplots",
    "37_methods_numbers",
]
for step in STEPS:
    include: f"rules/{step}.smk"


# Default target: the release of record (built by finalize_deliverables until it is cut), its deposit copies and
# the figure panels of the revision. Stages that rewrite objects of record are defined only when their config flag
# is set (scvi.retrain, annotation_round2.fit, atlas_annotation.rerun), and the rules that build a release only
# until it is cut (00_release.smk).
rule all:
    default_target: True
    input:
        RELEASE_TARGETS,
        rules.deposit_objects_all.input,
        rules.panels_mouse_tissue_all.input,
        rules.panels_mouse_stroma_all.input,
        rules.panels_human_tissue_all.input,
        rules.panels_human_epithelium_all.input,
        rules.panels_cross_species_all.input,
        rules.panels_marker_dotplots_all.input,
        rules.panels_programs_all.input,
        rules.samap_figures_all.input,
        rules.zone_modules_all.input,
        rules.methods_numbers_all.input,


# Release consistency ----
# Every rule file that reads the release of record registers the release folder it reads in RELEASE_READERS
# (00_release.smk). A reader that names another release fails the parse, so a cut cannot mix two releases in one run.
_stale_readers = {reader: release for reader, release in RELEASE_READERS.items() if release != RELEASE}

# The 04g2 folder of the release being cut carries its name, unless its version recorded a folder when it was cut;
# no release may build into the recorded folder of another, so a new cut cannot overwrite the sources of an earlier
# release that its MANIFEST.json names.
_recorded_folders = (config.get("release_round2") or {}).get("outdir_of_version") or {}
if RELEASE_VERSION not in _recorded_folders and RELEASE not in Path(RELEASE_BUILD_DIR).name:
    _stale_readers["config/config.yaml release_round2.outdir"] = RELEASE_BUILD_DIR
for _version, _folder in _recorded_folders.items():
    if _version != RELEASE_VERSION and Path(_folder) == Path(RELEASE_BUILD_DIR):
        _stale_readers[f"config/config.yaml release_round2.outdir_of_version.{_version}"] = _folder

if _stale_readers:
    raise ValueError(
        f"config deliverables.release is {RELEASE} ({RELEASE_VERSION}), but these readers name another release or "
        "folder:\n" + "\n".join(f"  {reader}: {release}" for reader, release in _stale_readers.items())
    )
