import pandas as pd
configfile: "config/config.yaml"
samples = pd.read_csv("config/samples.tsv", sep="\t").set_index("sample_id", drop=False)
SPECIES   = sorted(samples["species"].unique())
SLIDETAGS = list(samples.index[samples["modality"] == "slidetags"])


# Pin wildcards so latent_{species}.h5ad (stage 02) cannot swallow
# latent_{species}_{lineage}.h5ad (stage 04b). Without this, `integrate`
# matches species="mouse_perimetrium" and the DAG goes off a cliff.
wildcard_constraints:
    species="human|mouse",
    lineage="epithelial|immune|perimetrium|perivascular|smc|stromal|vascular",

def species_samples(w):
    ids = samples.index[samples["species"] == w.species]
    return expand("data/interim/raw/{sample}.h5ad", sample=ids)

for r in ["00a_slidetags","00_cellbender","00b_ingest","01_qc","01c_concat","01b_qc_report","02_integrate","03_cluster",
          "04_annotate","04b_reintegrate","04b2_reintegrate_round2","04c2_annotate_round2","04c_reannotate","98_clustree","04d_merge","04e_reembed","04f_spatial_qc","99_reports","05_de","06_pseudotime","07_spatial_pseudotime",
          "08_cellrank","09_pt_genes_mi","21_scenic",
          "22_crossspecies","23_invitro","90_figures","09_homology","10_samap"]:
    include: f"rules/{r}.smk"

rule all:
    input:
        *lineage_latents(),          # 04b per-lineage latents
        expand("results/tables/markers_{sp}.csv", sp=SPECIES),
        expand("results/tables/mi_{sp}.csv", sp=SPECIES),
        expand("results/tables/scenic_{sp}.csv", sp=SPECIES),
        "results/tables/conservation.csv",
        "data/interim/pt/global_mouse.h5ad",
        "data/interim/pt/cellrank_mouse.h5ad",
        expand("data/interim/pt/spatial_{s}.h5ad", s=SLIDETAGS),
        *spatial_qc_targets(),       # 04f spatial-coordinate QC (mouse; after annotation)
        "results/tables/invitro_comparison.csv",
        "results/figures/.done",
include: "rules/11_mi_pseudotime.smk"
include: "rules/12_spatial_gp.smk"
include: "rules/13_scenic.smk"
