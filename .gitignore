# Git tracks code, configuration, small curated resources and documentation. Pipeline outputs, data
# objects, installed environments and third-party documents stay on disk but are never tracked.
# Git reads "#" as a comment only at the start of a line, so no pattern carries a trailing comment.
# Later lines win over earlier ones; the global section at the end must stay last.

# Pipeline outputs and data ----
# Anchored at the repository root and written without a trailing slash, so a symlink that later
# replaces one of these folders is ignored as well.
/results
/logs
/data
/dataverse
/out
/.snakemake

# Root-level quarantine folders (only these; workflow/scripts/figures and resources/figures are code
# and inputs of the panel rules)
/_scratch
/figures

# Installed libraries; their specs and lockfiles in envs/ stay tracked
/envs/scmap_rlib
/envs/rlib_rrho
/envs/harmonypy_lib

# analysis/: exploratory work. Code, notebooks and notes are tracked; tables, figures, models, logs,
# spreadsheets and PDFs stay on disk untracked.
/analysis/**
!/analysis/**/
!/analysis/**/*.py
!/analysis/**/*.R
!/analysis/**/*.sh
!/analysis/**/*.ipynb
!/analysis/**/*.md

# notebooks/: the same rule; the rendered copies that rules write (*.executed.ipynb) are outputs
/notebooks/**
!/notebooks/**/
!/notebooks/**/*.ipynb
!/notebooks/**/*.py
!/notebooks/**/*.md
/notebooks/**/*.executed.ipynb

# Curation scaffolding, regenerated by tools/gen_04c_notebooks.py from resources/lineage_spec.yaml
/notebooks/curation

# notes/: tables and job logs written next to the analysis notes
/notes/**/*.csv
/notes/**/*.json
/notes/**/*.out

# resources/: third-party gene sets and supplements, and outputs that no rule reads
/resources/genesets
/resources/pnas.*
/resources/scores

# Global patterns ----
# Python and R environments, bytecode and package metadata
.venv*
__pycache__/
*.py[cod]
*.egg-info/

# Data objects and large matrices, wherever they sit
*.h5ad
*.h5mu
*.loom
*.mtx
*.qs
*.rds
*.pkl
*.npy
*.npz
*.pt

# Third-party papers and journal supplements are never deposited; own figures and tables are outputs
*.pdf
*.docx
*.xlsx

# Notebook checkpoints, backups, and macOS metadata
.ipynb_checkpoints/
*.bak*
*.pre-*
*.pre_*
._*
.DS_Store

# Orphan nested SAMap clone with example data (not part of the pipeline; untracked 2026-10-31)
/notebooks/SAMap/
